# Copy to .env and change every value marked CHANGE before deploying anywhere real.
# Use letters and digits only in passwords (they are embedded in connection URLs).

POSTGRES_DB=banking
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=CHANGEpostgres123

MONGO_USER=mongo_user
MONGO_PASSWORD=CHANGEmongo123

REDIS_PASSWORD=CHANGEredis123

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE-this-to-a-long-random-string
ACCESS_TOKEN_MINUTES=60

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost

# Loads mock customers/products on first start. Set to false outside demos.
SEED_DEMO_DATA=true
